{
  "id": "nmesh.table/v1",
  "title": "Table",
  "description": "Tabular data with typed columns.",
  "capabilities": [],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["columns", "rows"],
    "properties": {
      "title": { "type": "string" },
      "columns": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["key", "label"],
          "properties": {
            "key": { "type": "string" },
            "label": { "type": "string" },
            "type": { "enum": ["string", "number", "bool", "datetime", "pubkey"] }
          }
        }
      },
      "rows": {
        "type": "array",
        "maxItems": 1000,
        "items": { "type": "object" }
      }
    }
  }
}
